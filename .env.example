# OpenAI SDK Endpoint Configuration
# Default DeepSeek endpoint
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your_deepseek_or_opencode_api_key_here
AI_MODEL_NAME=deepseek-chat

# Alternative OpenCode Go / custom proxy example:
# AI_BASE_URL=https://api.opencode.go.id/v1
# AI_MODEL_NAME=deepseek-flash

# Browser & Test Harness Configuration
BROWSER_TYPE=chromium
HEADLESS=true
TIMEOUT_MS=30000
SLOW_MO_MS=0
MAX_AGENT_STEPS=25
SCREENSHOT_ON_FAILURE=true
REPORT_DIR=reports
